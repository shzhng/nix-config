{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/master/assets/oh-my-opencode.schema.json",

  // oh-my-openagent has no native OpenRouter provider support yet
  // (code-yeongyu/oh-my-openagent#1637), so every agent and category needs an
  // explicit model. All of them route through OpenRouter's auto router for
  // now; swap individual agents to pinned openrouter/<provider>/<model> ids
  // if per-role tuning turns out to matter. Requires the OpenRouter key to
  // be connected once via `opencode auth login`.
  "agents": {
    "sisyphus": { "model": "openrouter/auto" },
    "sisyphus-junior": { "model": "openrouter/auto" },
    "hephaestus": { "model": "openrouter/auto" },
    "prometheus": { "model": "openrouter/auto" },
    "oracle": { "model": "openrouter/auto" },
    "librarian": { "model": "openrouter/auto" },
    "explore": { "model": "openrouter/auto" },
    "multimodal-looker": { "model": "openrouter/auto" },
    "metis": { "model": "openrouter/auto" },
    "momus": { "model": "openrouter/auto" },
    "atlas": { "model": "openrouter/auto" }
  },

  // Sisyphus delegates subtasks by category; without these overrides the
  // built-in categories would route to first-party providers directly.
  "categories": {
    "quick": { "model": "openrouter/auto" },
    "unspecified-low": { "model": "openrouter/auto" },
    "unspecified-high": { "model": "openrouter/auto" },
    "visual-engineering": { "model": "openrouter/auto" },
    "deep": { "model": "openrouter/auto" },
    "ultrabrain": { "model": "openrouter/auto" },
    "writing": { "model": "openrouter/auto" }
  },

  // no PostHog analytics
  "telemetry": false
}
